<UserControl x:Class="MultiFunPlayer.UI.Dialogs.Views.ManualControlDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:s="https://github.com/canton7/Stylet"
 x:ClassModifier="internal">
 <StackPanel Width="500" Margin="24">
  <TextBlock Text="六轴手动控制" FontSize="22" Margin="0 0 0 12"/>
  <TextBlock Text="位置沿用各轴输出范围。打开窗口不会发送初始位置。关闭后断开串口并关闭自动连接，重新连接可恢复脚本输出。" TextWrapping="Wrap" Opacity=".7" Margin="0 0 0 16"/>
  <TextBlock Text="到达目标的缓冲时间（毫秒）"/>
  <DockPanel Margin="0 4 0 16">
   <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Width="60" VerticalAlignment="Center" TextAlignment="Right"/>
   <Slider Minimum="100" Maximum="10000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding Duration, Mode=TwoWay}"/>
  </DockPanel>
  <ItemsControl ItemsSource="{Binding Axes}" IsEnabled="{Binding IsReady}">
   <ItemsControl.ItemTemplate>
    <DataTemplate>
     <DockPanel Margin="0 6" IsEnabled="{Binding Enabled}">
      <TextBlock Text="{Binding Name}" Width="40" VerticalAlignment="Center"/>
      <TextBlock DockPanel.Dock="Right" Text="{Binding Position, StringFormat={}{0:F1}%}" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
      <Slider Minimum="0" Maximum="100" TickFrequency="0.1" Value="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
     </DockPanel>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0 16 0 8"/>
  <Button Content="关闭并断开连接" Command="{s:Action Dismiss}" HorizontalAlignment="Right"/>
 </StackPanel>
</UserControl>
